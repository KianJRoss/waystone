#!/usr/bin/env bash
# AppImage entry point for Waystone.
# Runs the bundled read-only Waystone tree with the bundled standalone Python + PySide6 runtime.
# All user data, config, cache, and state stay in the user's XDG directories (~/.local/share/waystone, ~/.config/waystone).
set -euo pipefail

APPDIR="${APPDIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
PY_ROOT="$APPDIR/usr/python"
PY_BIN="$PY_ROOT/bin/python3"

# Locate the python3.X stdlib directory inside usr/python/lib
PY_STDLIB_DIR="$(find "$PY_ROOT/lib" -maxdepth 1 -type d -name 'python3.*' | head -n 1)"
SITE_PACKAGES="$PY_STDLIB_DIR/site-packages"
QT_ROOT="$SITE_PACKAGES/PySide6/Qt"

export WAYSTONE_PYTHON="$PY_BIN"
export PYTHONHOME="$PY_ROOT"
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export DOTNET_ROOT="$APPDIR/usr/dotnet"
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1

export LD_LIBRARY_PATH="$APPDIR/usr/lib:$QT_ROOT/lib:$PY_ROOT/lib:${LD_LIBRARY_PATH:-}"
export QT_PLUGIN_PATH="$QT_ROOT/plugins"
export QML2_IMPORT_PATH="$QT_ROOT/qml"

if [[ -x "$QT_ROOT/libexec/QtWebEngineProcess" ]]; then
  export QTWEBENGINEPROCESS_PATH="$QT_ROOT/libexec/QtWebEngineProcess"
  export QTWEBENGINE_RESOURCES_PATH="$QT_ROOT/resources"
  export QTWEBENGINE_LOCALES_PATH="$QT_ROOT/translations/qtwebengine_locales"
fi

exec "$APPDIR/usr/share/waystone/open-waystone.sh" "$@"
