<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:UnifiedController.Linux.App.Controls"
        x:Class="UnifiedController.Linux.App.Views.MainWindow" Width="1440" Height="860" MinWidth="1040" MinHeight="640"
        Title="Unified Controller · Native Studio" Closing="OnClosing" x:CompileBindings="False">
  <!-- Deadband-fidelity verification (2026-11-04): mapping chips + selected-route pill; ProfileBar-style cards with surfaced native settings; device/capture cards; framed live telemetry. MainTabs remains Map..Live at indices 0..14. -->
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Margin="14">
    <Border Background="{DynamicResource UcNavBar}" CornerRadius="10" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource UcAccent}"><TextBlock Text="UC" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border><TextBlock Text="Unified Controller" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <ComboBox x:Name="InputSourcePicker" Classes="pill" MinWidth="180" PlaceholderText="Input source" SelectionChanged="InputSourcePicker_SelectionChanged"/>
          <Button x:Name="OutputPill" Classes="pill" Content="{Binding OutputSummary}" IsEnabled="False" MinWidth="200" HorizontalContentAlignment="Center"/>
          <ComboBox x:Name="MapperProfile" Classes="pill" MinWidth="155" SelectionChanged="MapperProfile_SelectionChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ToggleButton x:Name="QuickMouseToggle" Classes="pill" Content="Controller → mouse" Click="QuickMouseToggle_Click"/>
          <Border x:Name="StatusPill" Classes="card" Padding="10,5" Width="200"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="{DynamicResource UcOk}"/><TextBlock x:Name="StatusPillText" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"/></StackPanel></Border>
          <Button Classes="pill" Content="⚙"><Button.Flyout><Flyout><StackPanel Width="300" Spacing="8"><TextBlock Text="Appearance" Classes="cardTitle"/><TextBlock Text="Theme preset" Classes="dim"/><ComboBox x:Name="ThemePreset" SelectionChanged="ThemePreset_SelectionChanged"/><TextBlock Text="Accent color (#RRGGBB)" Classes="dim"/><TextBox x:Name="AccentColor" Watermark="#4B91F1"/><Button Content="Apply accent" Click="ApplyAccent_Click"/><TextBlock Text="Density" Classes="dim"/><ComboBox x:Name="DensityPicker" SelectionChanged="DensityPicker_SelectionChanged"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Comfortable"/><ComboBoxItem Content="Relaxed"/></ComboBox><Separator/><WrapPanel><Button Content="Start runtime" Click="Start_Click"/><Button Content="Stop runtime" Click="Stop_Click"/><Button Content="Hide window" Click="Hide_Click"/><Button Classes="danger" Content="Safe exit" Click="Exit_Click"/></WrapPanel><TextBlock Classes="hint" TextWrapping="Wrap" Text="Visual design inspired by Deadband, © 2026 broroeror, used under the MIT License."/></StackPanel></Flyout></Button.Flyout></Button>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" x:Name="MainTabs" Classes="nav" Margin="0,10,0,0">
      <TabItem Header="Map"><Grid ColumnDefinitions="2.25*,8,1.15*" Margin="0,8,0,0">
        <Grid RowDefinitions="1.6*,8,*">
          <Grid ColumnDefinitions="190,8,4*,8,1.35*">
            <Border Classes="card" Padding="10"><Grid RowDefinitions="Auto,*"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Button Mapping" Classes="cardTitle"/></StackPanel><ListBox Grid.Row="1" x:Name="MappingChipList" Margin="0,8,0,0" SelectionChanged="MappingChipList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="8,6" Margin="0,2"><Grid ColumnDefinitions="*,Auto,*"><TextBlock Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text=" → " Classes="dim"/><TextBlock Grid.Column="2" Text="{Binding DestinationLabel}" TextTrimming="CharacterEllipsis"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
            <Border Grid.Column="2" Classes="surfaceCard"><Grid RowDefinitions="Auto,*,Auto"><Grid ColumnDefinitions="*,Auto" Margin="10,5"><TextBlock Text="CONTROLLER  /  CLICK A CONTROL TO SELECT A SOURCE" Classes="eyebrow" VerticalAlignment="Center"/><CheckBox Grid.Column="1" x:Name="ShowMotionAxes" Content="Gyro axes" Click="ShowMotionAxes_Click"/></Grid><controls:ControllerSurface Grid.Row="1" x:Name="ControllerMapper"/><Border Grid.Row="2" Classes="card" Padding="9,5" HorizontalAlignment="Center" Margin="8"><TextBlock x:Name="SelectedMappingPill" Text="Select a control → unmapped"/></Border></Grid></Border>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
            <Border Grid.Column="4" Classes="surfaceCard"><Grid RowDefinitions="Auto,*"><TextBlock Text="MOUSE" Classes="eyebrow" Margin="10,5"/><controls:MouseSurface Grid.Row="1" x:Name="MouseMapper"/></Grid></Border>
          </Grid>
          <GridSplitter Grid.Row="1" ResizeDirection="Rows"/>
          <Border Grid.Row="2" Classes="surfaceCard"><Grid RowDefinitions="Auto,*"><TextBlock Text="FULL KEYBOARD  /  CLICK A KEY TO SELECT A SOURCE" Classes="eyebrow" Margin="10,5"/><controls:KeyboardSurface Grid.Row="1" x:Name="KeyboardMapper"/></Grid></Border>
        </Grid>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
        <Border Grid.Column="2" Classes="card" Padding="0"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12,10" Spacing="8">
        <StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock x:Name="AssignTitle" Text="Assign" Classes="cardTitle"/></StackPanel>
        <TextBlock Text="CONTROLLER REMAP" Classes="eyebrow"/>
        <TextBlock Text="1. Listen for the input.  2. Listen for what it should become.  3. Save." Classes="muted" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,8,*">
          <Border Classes="inspectorCard"><StackPanel><TextBlock Text="1 - INPUT" Classes="eyebrow"/><TextBlock x:Name="MapperSourceText" Text="Nothing selected" Classes="selection"/><Button x:Name="CaptureButton" Content="Listen for input" Click="MapperCapture_Click"/></StackPanel></Border>
          <Border Grid.Column="2" Classes="inspectorCard"><StackPanel><TextBlock Text="2 - OUTPUT" Classes="eyebrow"/><TextBlock x:Name="MapperOutputText" Text="Nothing selected" Classes="selection"/><Button x:Name="CaptureOutputButton" Content="Listen for output" Click="MapperOutputCapture_Click"/></StackPanel></Border>
        </Grid>
        <Grid ColumnDefinitions="*,8,*"><Button Content="SAVE REMAP" Classes="accent" FontWeight="Bold" Click="MapperAssign_Click"/><Button Grid.Column="2" Content="Nintendo face-button layout" Click="NintendoLayout_Click" ToolTip.Tip="Swap A/B and X/Y outputs"/></Grid>
        <TextBlock x:Name="LivePhysicalInputText" Text="Live physical input: idle" Classes="live"/>
        <TextBlock x:Name="MapperInstruction" Classes="muted" TextWrapping="Wrap"/>
        <Expander Header="Advanced mapping"><StackPanel Margin="0,7,0,0" Spacing="6">
          <TextBlock x:Name="MapperCurrentBinding" Classes="muted" Text="Current binding: none" TextWrapping="Wrap"/>
          <TextBlock Text="Destination category" Classes="eyebrow"/><ComboBox x:Name="DestinationGroup" HorizontalAlignment="Stretch" SelectionChanged="DestinationGroup_SelectionChanged"/>
          <TextBlock Text="Friendly target" Classes="eyebrow"/><ComboBox x:Name="DestinationTarget" HorizontalAlignment="Stretch" MinWidth="260" SelectionChanged="DestinationTarget_SelectionChanged"/>
          <Grid ColumnDefinitions="Auto,80,*" ColumnSpacing="7"><TextBlock Text="Output slot" VerticalAlignment="Center" Classes="muted"/><NumericUpDown Grid.Column="1" x:Name="MapperSlot" Minimum="1" Maximum="4" Value="1"/><WrapPanel Grid.Column="2" HorizontalAlignment="Right"><Button Content="Clear" Click="MapperClear_Click"/><Button Content="Remove" Classes="danger" Margin="6,0,0,0" Click="MapperRemove_Click"/><Button Content="Cancel" Margin="6,0,0,0" Click="MapperCancel_Click"/></WrapPanel></Grid>
          <ToggleButton x:Name="DestinationModeButton" Content="Pick output on picture" HorizontalAlignment="Stretch" Click="MapperDestinationMode_Click"/>
        </StackPanel></Expander>
        <Expander Header="Mod layer"><StackPanel Margin="0,7,0,0" Spacing="6"><TextBlock Text="Choose an input as the profile Mod key, then use the Routes tool for Mod-layer assignments." Classes="muted" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,8,*"><TextBox x:Name="MapModSource" Watermark="Controller:LB"/><ComboBox Grid.Column="2" x:Name="MapModBehavior"><ComboBoxItem Content="toggle"/><ComboBoxItem Content="one-shot"/><ComboBoxItem Content="hold"/></ComboBox></Grid><Button Content="Save Mod layer" HorizontalAlignment="Left" Click="SaveMapMod_Click"/></StackPanel></Expander>
        <Expander Header="Routes in this profile" IsExpanded="False"><DataGrid x:Name="MapperRoutes" Height="190" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="MapperRoute_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="SOURCE" Binding="{Binding SourceLabel}" Width="*"/><DataGridTextColumn Header="OUTPUT" Binding="{Binding DestinationLabel}" Width="*"/><DataGridTextColumn Header="P" Binding="{Binding Slot}" Width="30"/></DataGrid.Columns></DataGrid></Expander>
        <WrapPanel><Button Content="Tune sticks…" Click="OpenStickTuning_Click"/><Button Content="Motion axes…" Margin="6,0,0,0" Click="OpenMotionAxis_Click"/></WrapPanel>
        <TextBlock x:Name="MapperFeedback" Classes="feedback" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></Border>
      </Grid></TabItem>
      <TabItem Header="Sticks"><ContentControl x:Name="SticksHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Motion"><ContentControl x:Name="MotionHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Vibration"><ContentControl x:Name="VibrationHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Macros"><ContentControl x:Name="MacrosHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Hotkeys"><ContentControl x:Name="HotkeysHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Modules"><ContentControl x:Name="ModulesHost" Margin="4,8,4,0"/></TabItem>
      <TabItem Header="Profiles"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><Grid Margin="12" ColumnDefinitions="320,*" ColumnSpacing="12">
        <Border Classes="card" Padding="14"><StackPanel Spacing="9"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Profiles" Classes="cardTitle"/></StackPanel><ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged" MinHeight="300"/><WrapPanel><Button Classes="pill" Content="Duplicate" Click="Duplicate_Click"/><Button Classes="pill" Content="Rename" Click="Rename_Click"/><Button Classes="danger" Content="Delete" Click="Delete_Click"/><Button Classes="pill" Content="Import" Click="Import_Click"/><Button Classes="pill" Content="Export" Click="Export_Click"/></WrapPanel></StackPanel></Border>
        <StackPanel Grid.Column="1" Spacing="12"><Border Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Profile details" Classes="cardTitle"/></StackPanel><TextBlock Text="Name" Classes="eyebrow"/><TextBox x:Name="ProfileNameBox" Watermark="Unique name"/><TextBlock Text="Data file" Classes="eyebrow"/><TextBlock x:Name="ProfilePathText" Classes="dim" FontFamily="Monospace" TextWrapping="Wrap"/><TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Foreground="Orange"/><Button Classes="pill" HorizontalAlignment="Left" Content="Routes &amp; layers →" Click="OpenRoutes_Click"/></StackPanel></Border>
          <Border Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Native profile settings" Classes="cardTitle"/></StackPanel><TextBlock Text="Source merge policy" Classes="eyebrow"/><ComboBox x:Name="SourceMergePolicy" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="first_active"/><ComboBoxItem Content="all_connected"/></ComboBox><Grid ColumnDefinitions="*,220" ColumnSpacing="8"><TextBox x:Name="ModSource" Watermark="Mod key, e.g. Controller:LB"/><ComboBox Grid.Column="1" x:Name="ModBehavior"><ComboBoxItem Content="toggle"/><ComboBoxItem Content="one-shot"/><ComboBoxItem Content="hold"/></ComboBox></Grid><TextBlock Text="Enabled output slots" Classes="eyebrow"/><StackPanel Orientation="Horizontal" Spacing="14"><CheckBox x:Name="Output1" Content="Slot 1"/><CheckBox x:Name="Output2" Content="Slot 2"/><CheckBox x:Name="Output3" Content="Slot 3"/><CheckBox x:Name="Output4" Content="Slot 4"/></StackPanel><TextBlock Text="Per-device slot assignments (JSON)" Classes="eyebrow"/><TextBox x:Name="DeviceSlots" AcceptsReturn="True" Height="80" FontFamily="Monospace"/><Button Classes="accent" Content="Save profile settings" Click="SaveProfileSettings_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel>
      </Grid></ScrollViewer></TabItem>
      <TabItem Header="ROUTES" IsVisible="False"><ScrollViewer><StackPanel Margin="12" Spacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Routes, layers and effects" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" Classes="pill" Content="← Profiles" Click="OpenProfiles_Click"/></Grid>
        <TextBlock TextWrapping="Wrap" Text="Source and destination use the production vocabulary (for example Controller:A, Keyboard:Space, Mouse:Left, Desktop:Key:F11, Action:Macro:name). Listening reads the actual runtime input frame; it never fabricates controls."/>
        <DataGrid x:Name="RoutesGrid" AutoGenerateColumns="False" Height="300" IsReadOnly="True"><DataGrid.Columns>
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2*"/><DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="2*"/>
          <DataGridTextColumn Header="Layer / chord" Binding="{Binding Condition}" Width="*"/><DataGridTextColumn Header="Activator" Binding="{Binding Activator}" Width="*"/>
          <DataGridTextColumn Header="Effect" Binding="{Binding Effect}" Width="*"/><DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="55"/></DataGrid.Columns></DataGrid>
        <Grid ColumnDefinitions="*,*,120,120,100" ColumnSpacing="8"><TextBox x:Name="RouteSource" Watermark="Source"/><TextBox Grid.Column="1" x:Name="RouteDestination" Watermark="Destination"/>
          <ComboBox Grid.Column="2" x:Name="RouteLayer" PlaceholderText="Layer"><ComboBoxItem Content="Any"/><ComboBoxItem Content="Base"/><ComboBoxItem Content="Mod"/></ComboBox>
          <ComboBox Grid.Column="3" x:Name="RouteActivator"><ComboBoxItem Content="while-held"/><ComboBoxItem Content="press"/><ComboBoxItem Content="release"/><ComboBoxItem Content="tap"/><ComboBoxItem Content="hold"/><ComboBoxItem Content="double-tap"/></ComboBox>
          <NumericUpDown Grid.Column="4" x:Name="RouteSlot" Minimum="1" Maximum="4" Value="1"/></Grid>
        <Grid ColumnDefinitions="150,90,90,*,Auto,Auto,Auto" ColumnSpacing="8"><ComboBox x:Name="RouteEffect"><ComboBoxItem Content="normal"/><ComboBoxItem Content="toggle"/><ComboBoxItem Content="turbo"/></ComboBox>
          <NumericUpDown Grid.Column="1" x:Name="TurboRate" Minimum="1" Maximum="30" Value="12"/><NumericUpDown Grid.Column="2" x:Name="TurboDuty" Minimum="5" Maximum="95" Value="50"/>
          <TextBox Grid.Column="3" x:Name="RouteChord" Watermark="Chord sources, comma-separated"/><Button Grid.Column="4" Content="Listen" Click="Listen_Click"/><Button Grid.Column="5" Content="Add/update" Click="AddRoute_Click"/><Button Grid.Column="6" Content="Remove selected" Click="RemoveRoute_Click"/></Grid>
        <TextBlock Text="Turbo rate is Hz and duty is percent. Routes can target any enabled output slot." Foreground="Orange"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="LEGACY MACROS" IsVisible="False"><Grid Margin="12" ColumnDefinitions="220,*"><StackPanel Spacing="8"><TextBlock Text="MACROS" FontWeight="Bold"/><ListBox x:Name="MacroList" Height="350" SelectionChanged="MacroList_SelectionChanged"/><Button Content="New macro" Click="NewMacro_Click"/><Button Content="Delete macro" Click="DeleteMacro_Click"/><Button Content="Stop all running macros" Click="StopMacros_Click"/></StackPanel>
        <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="8"><TextBlock Text="Macro timeline" FontSize="20"/><Grid ColumnDefinitions="*,100,Auto" ColumnSpacing="8"><TextBox x:Name="MacroName" Watermark="Name"/><NumericUpDown Grid.Column="1" x:Name="MacroRepeats" Minimum="1" Maximum="100" Value="1"/><CheckBox Grid.Column="2" x:Name="MacroCancel" Content="Cancel on release"/></Grid>
          <DataGrid x:Name="StepsGrid" Height="270" AutoGenerateColumns="True" IsReadOnly="True"/><Grid ColumnDefinitions="120,*,90,90,Auto" ColumnSpacing="8"><ComboBox x:Name="StepType"><ComboBoxItem Content="press"/><ComboBoxItem Content="release"/><ComboBoxItem Content="axis"/><ComboBoxItem Content="delay"/><ComboBoxItem Content="action"/></ComboBox><TextBox Grid.Column="1" x:Name="StepTarget" Watermark="Target / native action"/><TextBox Grid.Column="2" x:Name="StepValue" Watermark="Value"/><TextBox Grid.Column="3" x:Name="StepDuration" Watermark="ms"/><Button Grid.Column="4" Content="Add step" Click="AddStep_Click"/></Grid>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Remove step" Click="RemoveStep_Click"/><Button Content="Move up" Click="MoveStepUp_Click"/><Button Content="Move down" Click="MoveStepDown_Click"/><Button Content="Save macro" Click="SaveMacro_Click"/></StackPanel>
        </StackPanel></Grid></TabItem>
      <TabItem Header="TUNE" IsVisible="False"><ScrollViewer><StackPanel Margin="12" Spacing="10"><TextBlock Text="Stick processing and controller mouse" FontSize="20"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="14" Height="160"><controls:StickResponsePlot x:Name="LeftStickPlot"/><controls:StickResponsePlot Grid.Column="1" x:Name="RightStickPlot"/></Grid><CheckBox x:Name="LeftEnabled" Content="Enable left stick processing"/><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><TextBox x:Name="LeftInner" Watermark="Inner deadzone 0–1"/><TextBox Grid.Column="1" x:Name="LeftOuter" Watermark="Outer range 0–1"/><TextBox Grid.Column="2" x:Name="LeftAnti" Watermark="Anti-deadzone 0–1"/><TextBox Grid.Column="3" x:Name="LeftCurve" Watermark="Curve 0.5–3"/></Grid>
        <CheckBox x:Name="RightEnabled" Content="Enable right stick processing"/><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><TextBox x:Name="RightInner" Watermark="Inner deadzone 0–1"/><TextBox Grid.Column="1" x:Name="RightOuter" Watermark="Outer range 0–1"/><TextBox Grid.Column="2" x:Name="RightAnti" Watermark="Anti-deadzone 0–1"/><TextBox Grid.Column="3" x:Name="RightCurve" Watermark="Curve 0.5–3"/></Grid><Button Content="Save stick tuning" Click="SaveSticks_Click" HorizontalAlignment="Left"/>
        <Separator/><CheckBox x:Name="ControllerMouseEnabled" Content="Enable controller mouse"/><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><TextBox x:Name="MouseToggle" Watermark="Toggle source"/><TextBox Grid.Column="1" x:Name="MouseStick" Watermark="Stick: left/right"/><TextBox Grid.Column="2" x:Name="MouseSensitivity" Watermark="Sensitivity"/><TextBox Grid.Column="3" x:Name="MouseDeadzone" Watermark="Deadzone"/></Grid>
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8"><TextBox x:Name="MouseLeftClick" Watermark="Left click source"/><TextBox Grid.Column="1" x:Name="MouseRightClick" Watermark="Right click source"/><TextBox Grid.Column="2" x:Name="MouseScrollUp" Watermark="Scroll up source"/><TextBox Grid.Column="3" x:Name="MouseScrollDown" Watermark="Scroll down source"/></Grid><Button Content="Save controller mouse" Click="SaveMouse_Click" HorizontalAlignment="Left"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="LEGACY MOTION" IsVisible="False"><StackPanel Margin="12" Spacing="10"><TextBlock Text="Motion mapping and calibration" FontSize="20"/><TextBlock Text="{Binding Motion}" FontFamily="Monospace"/>
        <ComboBox x:Name="MotionPreset" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="native"/><ComboBoxItem Content="gyro_aim"/><ComboBoxItem Content="tilt_drive"/><ComboBoxItem Content="dual_motion"/><ComboBoxItem Content="inertia_aim"/><ComboBoxItem Content="custom"/></ComboBox>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Custom left side (native JSON)"/><TextBox x:Name="MotionLeftConfig" AcceptsReturn="True" Height="210" FontFamily="Monospace"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Custom right side (native JSON)"/><TextBox x:Name="MotionRightConfig" AcceptsReturn="True" Height="210" FontFamily="Monospace"/></StackPanel></Grid>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save mapping" Click="SaveMotion_Click"/><Button Content="Calibrate still controller" Click="Calibrate_Click"/><Button Content="Recenter heading" Click="Recenter_Click"/></StackPanel><TextBlock TextWrapping="Wrap" Text="Custom side fields are enabled, mode (rate/tilt/inertia), x_axis, y_axis, x_enabled, y_enabled, full_scale, deadzone, curve, invert_x, invert_y, blend, activation, and coast_seconds. Unknown side fields are preserved."/>
      </StackPanel></TabItem>
      <TabItem Header="PROFILE" IsVisible="False"><TextBlock Text="Profile settings are available on Profiles."/></TabItem>
      <TabItem Header="Devices"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" Spacing="12"><ItemsControl x:Name="DevicesGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Width="310" Margin="0,0,10,10" Padding="14"><StackPanel Spacing="5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" Classes="cardTitle" TextTrimming="CharacterEllipsis"/><Border Grid.Column="1" Classes="card" Padding="7,3"><TextBlock Text="{Binding Status}"/></Border></Grid><TextBlock Text="{Binding Identity}" Classes="dim"/><TextBlock Text="{Binding StableId}" Classes="dim" FontFamily="Monospace" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="OpenDeadbandButton" Classes="pill" Content="Open GameSir in Deadband" HorizontalAlignment="Left" IsVisible="False" Click="OpenDeadband_Click"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Border Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Joy-Con pairing" Classes="cardTitle"/></StackPanel><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><TextBox x:Name="LeftJoyCon" Watermark="Left stable ID"/><TextBox Grid.Column="1" x:Name="RightJoyCon" Watermark="Right stable ID"/></Grid><WrapPanel><Button Classes="accent" Content="Pair L + R" Click="Pair_Click"/><Button Classes="danger" Content="Unpair selected" Click="Unpair_Click"/></WrapPanel><ListBox x:Name="PairList" Height="70"/></StackPanel></Border><Border Grid.Column="1" Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Capture" Classes="cardTitle"/></StackPanel><CheckBox x:Name="ExclusiveCapture" Content="Exclusive controller capture (opt-in)" Click="Capture_Click"/><TextBlock Classes="hint" Text="Prevents other apps from reading supported controllers while active." TextWrapping="Wrap"/><CheckBox x:Name="KeyboardCapture" Content="Keyboard capture (opt-in)" Click="Capture_Click"/><TextBlock Classes="hint" Text="Reads keyboard input for routes only while explicitly enabled." TextWrapping="Wrap"/><CheckBox x:Name="MouseCapture" Content="Mouse capture (opt-in)" Click="Capture_Click"/><TextBlock Classes="hint" Text="Reads mouse buttons and movement for routes only while enabled." TextWrapping="Wrap"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Live"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12" Spacing="12"><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Border Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Input frame" Classes="cardTitle"/></StackPanel><TextBlock Text="{Binding InputButtons}"/><TextBlock Text="{Binding InputAxes}" Classes="dim" FontFamily="Monospace"/><ProgressBar Value="{Binding InputActivity}" Maximum="100"/></StackPanel></Border><Border Grid.Column="1" Classes="card" Padding="14"><StackPanel Spacing="8"><StackPanel Orientation="Horizontal"><Border Classes="cardAccent"/><TextBlock Text="Output frame" Classes="cardTitle"/></StackPanel><TextBlock Text="{Binding OutputButtons}"/><TextBlock Text="{Binding OutputAxes}" Classes="dim" FontFamily="Monospace"/><ProgressBar Value="{Binding OutputActivity}" Maximum="100"/></StackPanel></Border></Grid><Grid ColumnDefinitions="*,*,*" ColumnSpacing="12"><Border Classes="card" Padding="14"><StackPanel><TextBlock Text="Loop timing" Classes="cardTitle"/><TextBlock Text="{Binding LoopTiming}" Classes="dim"/></StackPanel></Border><Border Grid.Column="1" Classes="card" Padding="14"><StackPanel><TextBlock Text="DSU &amp; rumble" Classes="cardTitle"/><TextBlock Text="{Binding DsuRumble}" Classes="dim" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Classes="card" Padding="14"><StackPanel><TextBlock Text="Active modes" Classes="cardTitle"/><TextBlock Text="{Binding ActiveModes}" Classes="dim" TextWrapping="Wrap"/></StackPanel></Border></Grid><Border Classes="card" Padding="14"><StackPanel Spacing="6"><TextBlock Text="Limitations" Classes="cardTitle"/><ItemsControl ItemsSource="{Binding Snapshot.Limitations}"/><TextBlock Text="Not ported" Foreground="Orange"/><TextBlock Classes="dim" TextWrapping="Wrap" Text="Fishing audio/perception helpers, Windows GameInput, and Windows Bluetooth management remain unsupported on Linux."/></StackPanel></Border><Expander Header="Raw telemetry"><TextBlock Text="{Binding Telemetry}" FontFamily="Monospace" TextWrapping="Wrap" Margin="8"/></Expander></StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="Profiles are validated before atomic save · global desktop capture remains opt-in · close hides the studio" Opacity=".65"/>
  </Grid>
</Window>
